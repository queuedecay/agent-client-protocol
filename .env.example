# Copy this file to server/.env before starting either bridge.
# server/.env is gitignored — never commit real secrets.

# --- Copilot SDK bridge (server/copilot-bridge.mjs) ---
# Auth is handled by your locally installed & logged-in `copilot` CLI, not by
# an env var here. This just controls SDK log verbosity.
COPILOT_SDK_LOG_LEVEL=error
COPILOT_BRIDGE_PORT=8787

# --- ACP bridge (server/acp-bridge.mjs) ---
# Required: the exact command used to launch an ACP-compliant agent process.
# The bridge refuses to start without this set explicitly.
# Example: npx @zed-industries/claude-code-acp
ACP_AGENT_COMMAND=
ACP_BRIDGE_PORT=8788

# Any secret the chosen ACP agent itself requires (e.g. a model API key) goes
# here too, and is passed through to the agent subprocess only — never logged,
# never sent to the browser.
# ACP_AGENT_API_KEY=
